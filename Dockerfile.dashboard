# FinGuard — Streamlit analytics dashboard
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY dashboard/ dashboard/

# artifacts/ is gitignored (regenerated by training).
# data/ contains a 150 MB CSV (gitignored — too large for git).
# Both are mounted at runtime via Docker volumes or env vars.
# Pre-create the dirs so the image always builds in CI.
RUN mkdir -p artifacts data

COPY artifacts/ artifacts/

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "dashboard/app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", \
     "--server.headless=true"]
