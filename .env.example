# ── FinGuard environment configuration ──────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://finguard_user:change_me@localhost:5432/finguard

# MLflow tracking server (local file store by default)
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=finguard-fraud-detection

# FastAPI service
API_HOST=0.0.0.0
API_PORT=8000
MODEL_PATH=artifacts/model.pkl
SCALER_PATH=artifacts/scaler.pkl
METRICS_PATH=artifacts/metrics.json

# Streamlit dashboard
API_BASE_URL=http://localhost:8000
DATA_PATH=data/creditcard.csv

# Threshold optimizer: assumed cost (EUR) of one falsely declined
# legitimate transaction (industry estimates range 15-118)
FP_COST=30

# Postgres container bootstrap (used by docker-compose)
POSTGRES_USER=finguard_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=finguard
